{
  "sourceLanguage": "en",
  "strings": {
    "BUTTON_BACK": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もどる"
          }
        }
      }
    },
    "BUTTON_END": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とじる"
          }
        }
      }
    },
    "BUTTON_NEXT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つぎへ"
          }
        }
      }
    },
    "QRコードにかざすだけ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just hold it over a QR code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードにかざすだけ"
          }
        }
      }
    },
    "QRコードの情報がすぐに表示されます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR code information is displayed immediately"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードの情報がすぐに表示されます"
          }
        }
      }
    },
    "QRコードの情報を簡単に取得できます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can easily get information from QR codes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードの情報を簡単に取得できます"
          }
        }
      }
    },
    "camera.denied.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を開く"
          }
        }
      }
    },
    "camera.denied.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To scan QR codes, allow QRReader to use the camera in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードを読み取るには、設定でQRReaderのカメラを許可してください。"
          }
        }
      }
    },
    "camera.denied.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスが許可されていません"
          }
        }
      }
    },
    "camera.notDetermined.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "camera.notDetermined.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is needed to scan QR codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードの読み取りにはカメラを使用します。"
          }
        }
      }
    },
    "camera.notDetermined.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera to scan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使って読み取る"
          }
        }
      }
    },
    "camera.restricted.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time or a device profile prevents camera use. This can't be changed from the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンタイムや管理者のプロファイルなど、この端末の制限によりカメラを利用できません。アプリからは変更できません。"
          }
        }
      }
    },
    "camera.restricted.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera use is restricted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラの利用が制限されています"
          }
        }
      }
    },
    "camera.unavailable.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no camera, or another app is using it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末にカメラがないか、ほかのアプリが使用中のため利用できません。"
          }
        }
      }
    },
    "camera.unavailable.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera unavailable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを利用できません"
          }
        }
      }
    },
    "common.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "common.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        }
      }
    },
    "history.clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear All"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて消去"
          }
        }
      }
    },
    "history.clear.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去"
          }
        }
      }
    },
    "history.clear.damagedMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved history is unreadable and will be erased. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された履歴を読み込めないため、消去します。元に戻せません。"
          }
        }
      }
    },
    "history.clear.message %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items will be removed. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の履歴を消去します。元に戻せません。"
          }
        }
      }
    },
    "history.clear.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear all history?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴をすべて消去しますか？"
          }
        }
      }
    },
    "history.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "history.delete.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this item?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この履歴を削除しますか？"
          }
        }
      }
    },
    "history.empty.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Scan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンへ移動"
          }
        }
      }
    },
    "history.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned QR codes appear here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取ったQRコードがここに表示されます"
          }
        }
      }
    },
    "history.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No history yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴はありません"
          }
        }
      }
    },
    "history.error.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear History"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を消去"
          }
        }
      }
    },
    "history.error.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved history is damaged. New scans are not saved until it is cleared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された履歴が壊れています。消去するまで、新しい読み取りは保存されません。"
          }
        }
      }
    },
    "history.error.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History can't be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を読み込めません"
          }
        }
      }
    },
    "history.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴"
          }
        }
      }
    },
    "intro.fine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will ask for permission to use the camera next."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の画面でiOSがカメラの使用許可を確認します"
          }
        }
      }
    },
    "intro.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links are never opened automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが自動で開くことはありません。"
          }
        }
      }
    },
    "intro.start": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        }
      }
    },
    "intro.start.camera": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
