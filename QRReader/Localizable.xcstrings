    "intro.step2.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認する"
          }
        }
      }
    },
    "intro.step3.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy or share whenever you need"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときにコピー・共有できます"
