    "intro.step1.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point the camera at a QR code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラをQRコードに向けるだけ"
          }
        }
      }
    },
    "intro.step1.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取る"
          }
        }
      }
    },
    "intro.step2.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the contents exactly as scanned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容をそのまま表示します"
